## Base de datos ──────────────────────────────────────────────────────────────
# Local (Docker o Postgres instalado):
DATABASE_URL=postgres://conecta:conecta@localhost:5432/conecta
# En Railway: NO pegues la cadena. Usa una referencia de variable para viajar
# por la red privada y no pagar egreso:  ${{Postgres.DATABASE_URL}}
# Si conectas por el proxy público de Railway, además:
# DATABASE_SSL=true

## Identidad ──────────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# URL pública de la aplicación (sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

## Centro de Control ──────────────────────────────────────────────────────────
# Correos con acceso al backoffice, separados por coma
ADMIN_EMAILS=rodrigo.duran@prtconsulting.cl

## Capa de IA (opcional) ──────────────────────────────────────────────────────
# Sin esta clave, la interpretación de lenguaje natural corre con reglas.
# Con ella, el modelo toma el relevo y devuelve la misma estructura.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

## Opcionales de infraestructura ──────────────────────────────────────────────
# DATABASE_POOL_MAX=5
